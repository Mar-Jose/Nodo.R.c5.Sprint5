<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar País: <%= paisesE.nombreOficial || paisesE.nombreOfficial %></title>
    <link rel="stylesheet" href="/src/index.css">
    </head>
<body class="m-0 min-h-screen min-w-[320px] bg-[#f0f0f0] p-5 font-sans text-[#242424]">

    <%- include('./partials/navbar') %>

    <div class="mx-auto max-w-[600px] border border-[#ccc] bg-[rgb(133,193,77)] p-5">
        <h1 class="mb-4 text-2xl font-bold">Editar País: <%= paisesE.nombreOficial || paisesE.nombreOfficial %></h1>

        <form class="space-y-2" action="/api/paisesA/editar/<%= paisesE.id || paisesE._id %>?_method=PUT" method="POST">
                    <!--para html post ya no acepta put-->
    <!--para cumplir con 1 standard se escribe put q lo convierte en post con el método override, el servidor lo interpreta como put-->
    <!-- validaciones tipo from, que son las q aparecen en html instantaneamente -->  
   
   <label class="mt-2.5 block font-bold">Nombre oficial del país:</label>
   <input class="mt-1 w-full border border-[#ddd] p-2" type="text" name="nombreOficial" value="<%= paisesE.nombreOficial || paisesE.nombreOfficial || '' %>" required minlength="3" maxlength="90">
   <span class="block text-[rgb(105,19,19)]"> Nombre oficial del país es requerido debe tener entre  3-90 caracteres</span>

    <label class="mt-2.5 block font-bold">Capital:</label>
    <input class="mt-1 w-full border border-[#ddd] p-2" type="text" name="capital" value="<%= Array.isArray(paisesE.capital) ? paisesE.capital.join(', ') : paisesE.capital || '' %>" required minlength="3" maxlength="90">
    <span class="block text-[rgb(105,19,19)]"> La capital del país es requerido, debe tener entre 3 hasta 90 letras</span>
    
    <label class="mt-2.5 block font-bold">Países limítrofes:</label>
    <input class="mt-1 w-full border border-[#ddd] p-2" type="text" name="borders" value="<%= Array.isArray(paisesE.borders) ? paisesE.borders.join(', ') : paisesE.borders || '' %>" pattern="^([A-Z]{3})(([, ]+[A-Z]{3})*)$" placeholder="Ej: ARG, BRA">
    <span class="block text-[rgb(105,19,19)]"> Opcional: códigos de 3 letras separados por coma o espacio</span>

    <label class="mt-2.5 block font-bold">Área:</label>
    <input class="mt-1 w-full border border-[#ddd] p-2" type="number" name="area" value="<%= paisesE.area %>" required min="0" title="El área del país es requerida">
    <span class="block text-[rgb(105,19,19)]"> El área del país debe ser un número positivo</span>

    <label class="mt-2.5 block font-bold" for="languages">Idioma:</label>
    <input class="mt-1 w-full border border-[#ddd] p-2" type="text" id="languages" name="languages" value="<%= Array.isArray(paisesE.languages) ? paisesE.languages.join(', ') : paisesE.languages || '' %>" required>
    <span class="block text-[rgb(105,19,19)]">El idioma es requerido.</span>

    <label class="mt-2.5 block font-bold" for="image">URL de bandera:</label>
    <input class="mt-1 w-full border border-[#ddd] p-2" type="url" id="image" name="image" value="<%= paisesE.image || '' %>">
    
    <%# sprint 3. tp 3. Etapa 3. %>
           <button class="mt-5 cursor-pointer rounded-[5px] border-2 border-[#003366] bg-[#d0ebff] px-3 py-2 font-bold text-[#003366] transition duration-300 hover:scale-105 hover:bg-[#003366] hover:text-white focus-visible:scale-105 focus-visible:bg-[#003366] focus-visible:text-white" type="submit">
                Guardar Cambios
            </button>
            <a class="ml-4" href="/api/paisesA">Cancelar</a>

        </form>
    </div>
</body>
</html>