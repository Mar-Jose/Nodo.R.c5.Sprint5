 <!-- modificado -->
<!DOCTYPE html>
<html lang="es">
<head>
 <meta charset="UTF-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
 <title>Países Hispanohablantes</title>

 <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <style>
                body {
                    font-family: sans-serif;
                    background-color: #57977f; 
                }
                .container {
                    max-width: 1200px;
                    margin: 0 auto;
                    padding: 20px;
                }
                .paisP-card {
                    border: 1px solid #ccc;
                    padding: 15px;
                    margin-bottom: 20px;
                    background-color: white;
                }
                .country-heading {
                    display: flex;
                    align-items: center;
                    gap: 12px;
                }
                .country-flag {
                    width: 64px;
                    height: 42px;
                    object-fit: contain;
                }
                .card-action {
                    display: inline-block;
                    padding: 8px 12px;
                    margin-right: 5px;
                    cursor: pointer;
                    border: 4px double;
                    border-radius: 7px;
                    font: inherit;
                    font-weight: bold;
                    text-decoration: none;
                    transition: all 0.3s ease;
                }
                .edit-button {
                    background-color: #007bff;
                    border-color: #003366;
                    color: #fff;
                }
                .edit-button:hover,
                .edit-button:focus-visible {
                    background-color: #003366;
                    color: #000;
                    transform: scale(1.05);
                }
                .delete-button {
                    background-color: #dc3545;
                    border-color: #800020;
                    color: #fff;
                }
                .delete-button:hover,
                .delete-button:focus-visible {
                    background-color: #800020;
                    color: #000;
                    transform: scale(1.05);
                }
                .add-button {
                    position: fixed;
                    top: 19px;
                    right: 24px;
                    z-index: 1;
                    padding: 10px 14px;
                    background-color: #39ff14;
                    color: #0b3d0b;
                    border: 4px double #0b3d0b;
                    border-radius: 7px;
                    text-decoration: none;
                    font-weight: bold;
                    transition: all 0.3s ease;
                }
                .add-button:hover {
                    background-color: #0b3d0b;
                    color: #ffffff;
                    transform: scale(1.05);
                }
        </style>
</head>

<body>

<%- include('partials/navbar') %>
<a href="/api/paisesA/agregar" class="add-button">Agregar país</a>

<section class="container" style="text-align: center;">
    
    <h1>Países</h1>
    <h2>Hispanohablantes</h2>
</section>
     

<main class="container">
 <div style="display: flex; flex-wrap: wrap; gap: 20px;">

 <% if (paisesD.length > 0) { %>
 <% paisesD.forEach(PEc => { %>

    <!-- <article class="hero-card" style="flex: 1 1 calc(50% - 20px);"> -->
        <article class="paisP-card" 
        style="
                display: inline-block; 
                width: auto;
                max-width: 500px;
                padding: 20px; 
                background: #ffe6f2;        
                border: 4px double #000;    
                border-radius: 10px;
                margin: 10px; ">

        <div class="country-heading">
            <h3><%= PEc.nombreOficial || PEc.nombreOfficial %></h3>
            <% if (PEc.image) { %>
                <img
                    class="country-flag"
                    src="<%= PEc.image %>"
                    alt="Bandera de <%= PEc.nombreOficial || PEc.nombreOfficial %>"
                >
            <% } %>
        </div>
        <p><strong>Nombre oficial:</strong> <%= PEc.nombreOficial || PEc.nombreOfficial %></p>
        <p><strong>Capital:</strong> <%= Array.isArray(PEc.capital) ? PEc.capital.join(', ') : PEc.capital || 'Sin capital' %></p>
        <p><strong>Idioma:</strong> <%= Array.isArray(PEc.languages) ? PEc.languages.join(', ') : PEc.languages || 'Sin idioma' %></p>
        <p><strong>Países limítrofes:</strong> <%= Array.isArray(PEc.borders) ? PEc.borders.join(', ') : PEc.borders || 'Sin fronteras' %></p>
        <p><strong>Área:</strong> <%= PEc.area %></p>
            <!-- - BOTÓN EDITAR - -->
            <a href="/api/paisesA/editar/<%= PEc.id || PEc._id %>"
               class="card-action edit-button">
               Editar
            </a>

                    <% if (success) { %>
                <script>
                let mensajes = {
                    created: 'El país creado y guardado en la base de datos del grupo 30.',
                    updated: 'El país seleccionado fue editado correctamente',
                };

                Swal.fire({
                    icon: 'success',
                    title: 'ok',
                    text: mensajes['<%= success %>'],
                    timer: 3000,
                    showConfirmButton: false
                });
                </script>
                <% } %>

            <!-- Sprint 3. tp 3. Etapa 5. Requerimiento 1: BOTÓN ELIMINAR -->
            <form id="form-<%= PEc.id || PEc._id %>" 
                  action="/api/paisesA/id/<%= PEc.id || PEc._id %>?_method=DELETE" 
                  method="POST" 
                  style="display: inline;">

                <button type="button"
                        class="card-action delete-button"
                        onclick="confirmarEliminacion('<%= PEc.id || PEc._id %>')">
                    Eliminar
                </button>
            </form>

    </article>

 <% }) %>
 <% } else { %>
    <p>No hay un país para mostrar.</p>
 <% } %>

 </div>
</main>

<script>
function confirmarEliminacion(PEc) {
    Swal.fire({
        title: '¿Estás seguro?',
        text: 'Esta acción eliminará permanentemente al país de su base de datos.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Sí, eliminar',
        cancelButtonText: 'Cancelar',
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6'
    }).then((result) => {
        if (result.isConfirmed) {
            Swal.fire({
                title: 'Eliminado',
                text: 'El país fue borrado exitosamente.',
                icon: 'success',
                timer: 3000,
                showConfirmButton: false
            }).then(() => {
                document.getElementById('form-' + PEc).submit();
            });
        }
    });
}
</script>

</body>
</html>