 <!-- modificado -->
<!DOCTYPE html>
<html lang="es">
<head>
 <meta charset="UTF-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
 <title>Países Hispanohablantes</title>
 <link rel="stylesheet" href="/src/index.css">

 <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body class="m-0 min-h-screen min-w-[320px] bg-[#57977f] font-sans text-[#242424]">

<%- include('./partials/navbar') %>

<section class="mx-auto max-w-[1200px] p-5 text-center">
    
    <h1 class="my-4 text-3xl font-bold">Países</h1>
    <h2 class="my-4 text-2xl font-bold">Hispanohablantes</h2>
</section>
     

<main class="mx-auto max-w-[1200px] p-5">
 <div class="flex flex-wrap gap-5">

 <% if (paisesD.length > 0) { %>
 <% paisesD.forEach(PEc => { %>

        <article class="m-[10px] inline-block w-auto max-w-[500px] rounded-[10px] border-4 border-double border-black bg-[#ffe6f2] p-5">

        <div class="flex items-center gap-3">
            <h3 class="my-4 text-xl font-bold"><%= PEc.nombreOficial || PEc.nombreOfficial %></h3>
            <% if (PEc.image) { %>
                <img
                    class="h-[42px] w-16 object-contain"
                    src="<%= PEc.image %>"
                    alt="Bandera de <%= PEc.nombreOficial || PEc.nombreOfficial %>"
                >
            <% } %>
        </div>
        <p class="my-4"><strong>Nombre oficial:</strong> <%= PEc.nombreOficial || PEc.nombreOfficial %></p>
        <p class="my-4"><strong>Capital:</strong> <%= Array.isArray(PEc.capital) ? PEc.capital.join(', ') : PEc.capital || 'Sin capital' %></p>
        <p class="my-4"><strong>Idioma:</strong> <%= Array.isArray(PEc.languages) ? PEc.languages.join(', ') : PEc.languages || 'Sin idioma' %></p>
        <p class="my-4"><strong>Países limítrofes:</strong> <%= Array.isArray(PEc.borders) ? PEc.borders.join(', ') : PEc.borders || 'Sin fronteras' %></p>
        <p class="my-4"><strong>Área:</strong> <%= PEc.area %></p>
            <!-- - BOTÓN EDITAR - -->
            <a href="/api/paisesA/editar/<%= PEc.id || PEc._id %>"
               class="mr-1 inline-block cursor-pointer rounded-[7px] border-4 border-double border-[#003366] bg-[#007bff] px-3 py-2 font-sans font-bold text-white no-underline transition-all duration-300 hover:scale-105 hover:bg-[#003366] hover:text-black focus-visible:scale-105 focus-visible:bg-[#003366] focus-visible:text-black">
               Editar
            </a>

            <!-- Sprint 3. tp 3. Etapa 5. Requerimiento 1: BOTÓN ELIMINAR -->
            <form id="form-<%= PEc.id || PEc._id %>" 
                  action="/api/paisesA/id/<%= PEc.id || PEc._id %>?_method=DELETE" 
                  method="POST" 
                  class="inline">

                <button type="button"
                        class="mr-1 inline-block cursor-pointer rounded-[7px] border-4 border-double border-[#800020] bg-[#dc3545] px-3 py-2 font-sans font-bold text-white transition-all duration-300 hover:scale-105 hover:bg-[#800020] hover:text-black focus-visible:scale-105 focus-visible:bg-[#800020] focus-visible:text-black"
                        onclick="confirmarEliminacion('<%= PEc.id || PEc._id %>')">
                    Eliminar
                </button>
            </form>

    </article>

 <% }) %>
 <% } else { %>
    <p class="my-4">No hay un país para mostrar.</p>
 <% } %>

 </div>
</main>

<%- include('./partials/modal', { success }) %>

</body>
</html>