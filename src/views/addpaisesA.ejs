<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Agregar País</title>
    <link rel="stylesheet" href="/src/index.css">
</head>
<body class="m-0 min-h-screen min-w-[320px] bg-[#f0f0f0] p-5 font-sans text-[#242424]">
<%- include('./partials/navbar') %>
<!-- sprint 3. tp 3. Etapa 3. Requerimiento 5.  -->
   
 <div class="mx-auto max-w-[600px] border border-[#ccc] bg-[rgb(133,193,77)] p-5">
  <h2 class="mb-4 text-2xl font-bold">Agregar Nuevo País</h2>
  <form class="space-y-2" action="/api/paisesA/agregar" method="POST">
<!-- validaciones tipo from, que son las q aparecen en html instantaneamente -->   

   <label class="mt-2.5 block font-bold">Nombre oficial del país:</label>
   <input class="mt-1 w-full border border-[#ddd] p-2" type="text" name="nombreOficial" required minlength="3" maxlength="90">
   <span class="block text-[rgb(105,19,19)]"> Nombre oficial del país es requerido debe tener entre  3-90 caracteres</span>

    <label class="mt-2.5 block font-bold">capital del país:</label>
    <input class="mt-1 w-full border border-[#ddd] p-2" type="text" name="capital" required minlength="3" maxlength="90">
    <span class="block text-[rgb(105,19,19)]"> La capital del país es requerido, debe tener entre 3 hasta 90 letras</span>
    
    <label class="mt-2.5 block font-bold">Países limítrofes:</label>
    <input class="mt-1 w-full border border-[#ddd] p-2" type="text" name="borders" pattern="^([A-Z]{3})(([, ]+[A-Z]{3})*)$" placeholder="Ej: ARG, BRA">
    <span class="block text-[rgb(105,19,19)]"> Opcional: códigos de 3 letras separados por coma o espacio</span>

    <label class="mt-2.5 block font-bold">Área:</label>
    <input class="mt-1 w-full border border-[#ddd] p-2" type="number" name="area" required min="0">
    <span class="block text-[rgb(105,19,19)]"> El área del país debe ser un número positivo</span>

<label class="mt-2.5 block font-bold" for="languages">Idioma:</label>
<input class="mt-1 w-full border border-[#ddd] p-2" type="text" id="languages" name="languages" required>

<label class="mt-2.5 block font-bold" for="image">URL de bandera:</label>
<input class="mt-1 w-full border border-[#ddd] p-2" type="url" id="image" name="image">

<% if (typeof errores !== 'undefined' && errores.length) { %>
  <ul class="text-[#a00]">
    <% errores.forEach(error => { %><li><%= error.msg %></li><% }) %>
  </ul>
<% } %>

<!-- sprint 3. tp 3. Etapa 3. Requerimiento 6: <button type="submit">Guardar Superhéroe</button> -->

   <button class="mt-5 cursor-pointer rounded-[5px] border-2 border-[#2f4f2f] bg-[#dbeecb] px-3 py-2 font-bold text-[#2f4f2f] transition duration-300 hover:bg-[#2f4f2f] hover:text-white focus-visible:bg-[#2f4f2f] focus-visible:text-white" type="submit">
   Guardar País
</button>

   <a class="ml-4 inline-block rounded-[5px] border-2 border-[#800020] bg-[#ffe6f0] px-3 py-2 font-bold text-[#800020] no-underline transition duration-300 hover:bg-[#800020] hover:text-white focus-visible:bg-[#800020] focus-visible:text-white" href="/api/paisesA">
   Volver
</a>   
 </form>
</div>
</body>
</html>